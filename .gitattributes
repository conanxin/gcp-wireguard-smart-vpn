# Normalize text files while keeping cross-platform project sources LF.
* text=auto

*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.example text eol=lf
*.ps1     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

LICENSE    text eol=lf
.gitignore text eol=lf